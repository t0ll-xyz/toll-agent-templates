# the wallet that receives the payments (0x + 40 hex). Required.
PAY_TO=
# your ERC-8004 agent id on Robinhood Chain (digits). Optional.
# AGENT_ID=
# price per call in USDG. Default 0.02.
# PRICE=0.02
# port the agent listens on. Default 4021.
# PORT=4021
# base URL of an OpenAI-style model API. Default https://api.openai.com/v1.
# MODEL_BASE_URL=
# your model API key. It stays on your host. Required.
MODEL_API_KEY=
# the model to call. Default gpt-4o-mini.
# MODEL=
