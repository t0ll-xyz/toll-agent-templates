# the wallet that receives the payments (0x + 40 hex). Required.
PAY_TO=
# your ERC-8004 agent id on Robinhood Chain (digits). Optional.
# AGENT_ID=
# price per call in USDG, for example 0.01. Required, no default.
PRICE=
# port the agent listens on. Default 4021.
# PORT=4021
# REQUIRED. The https URL of the API to wrap (public host only)
UPSTREAM_URL=
# an auth header sent to the upstream, as Name: value (optional)
# UPSTREAM_AUTH_HEADER=
