# the wallet that receives the payments (0x + 40 hex). Required.
PAY_TO=
# your ERC-8004 agent id on Robinhood Chain (digits). Optional.
# AGENT_ID=
# price per call in USDG. Default 0.01.
# PRICE=0.01
# port the agent listens on. Default 4021.
# PORT=4021
# a Toll API key, if you have one (sent to Toll as x-api-key)
# TOLL_KEY=
# a THROWAWAY wallet key on your host, used only to pay Toll's x402 check past the free quota
# TOLL_PAYER_KEY=
