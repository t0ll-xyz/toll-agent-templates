# the wallet that receives the payments (0x + 40 hex). Required.
PAY_TO=
# your ERC-8004 agent id on Robinhood Chain (digits). Optional.
# AGENT_ID=
# price per call in USDG. Default 0.05.
# PRICE=0.05
# port the agent listens on. Default 4021.
# PORT=4021
# REQUIRED. A contact string for SEC's User-Agent rule, e.g. Your Name you@example.com. SEC sees it, so use a contact you are fine making public.
SEC_USER_AGENT=
# a THROWAWAY wallet key on your host, used only to pay Toll's x402 reads past the free rate
# TOLL_PAYER_KEY=
