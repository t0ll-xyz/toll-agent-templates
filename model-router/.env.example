# the wallet that receives the payments (0x + 40 hex). Required.
PAY_TO=
# your ERC-8004 agent id on Robinhood Chain (digits). Optional.
# AGENT_ID=
# price per call in USDG. Default 0.001.
# PRICE=0.001
# port the agent listens on. Default 4021.
# PORT=4021
# base URL of an OpenAI-style API (default https://api.openai.com/v1)
# MODEL_BASE_URL=
# REQUIRED. Your model API key. It stays on your host.
MODEL_API_KEY=
# force this model name on every call (optional)
# MODEL=
